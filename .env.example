# Local-only settings. Never use these values for a deployed environment.
BETTER_AUTH_URL=http://localhost:4321
AUTH_SECRET=local-development-secret-do-not-use-in-production
AUTH_GITHUB_ID=local-development
AUTH_GITHUB_SECRET=local-development
D3_EMAIL=owner@example.test
# Set privately in ignored .dev.vars to test the admin password login.
ADMIN_PASSWORD=

# Optional GitHub fine-grained token with read-only Contents access to obsidianNotes.
GITHUB_CONTENT_TOKEN=

# Local Obsidian checkout used to bundle Now and quote content into the Worker.
OBSIDIAN_NOTES_DIR=/home/d3/Documents/obsidiannotes

# The Cloudflare adapter uses this local database URL to emulate Hyperdrive.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_SITE_SETTINGS_DB=postgresql://site_dev:site_dev_local_only@127.0.0.1:55432/site_dev
DATABASE_URL=postgresql://site_dev:site_dev_local_only@127.0.0.1:55432/site_dev
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://site_dev:site_dev_local_only@127.0.0.1:55432/site_dev
