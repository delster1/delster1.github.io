---
import "../styles/global.css";
const { title } = Astro.props;
---

<html lang="en" data-webtui-theme="everforest-dark-soft">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? "Terminal"}</title>
  </head>

    <style>
      body {
        margin: 0;
        font: clamp(0.95rem, 0.3vw + 0.9rem, 1.15rem)/1.6 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--text);
      }
      a { color: var(--site-accent, var(--accent)); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 860px; margin: 0 auto; padding: 32px 20px 56px; }
      header, footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      header { margin-bottom: 28px; }
      .muted { color: var(--muted); }
    </style>
  <body class="text-[var(--terminal-text)] min-h-screen p-4">
    <div class=" mx-auto">
      <slot />
    </div>
    <div id="appearance-status" class="appearance-toast" role="status" aria-live="polite" hidden></div>
    <script>
      import { initializeAppearance } from "../lib/appearance-client";

      initializeAppearance();
    </script>
  </body>
</html>
