---
import TerminalLayout from "../layouts/TerminalLayout.astro";
import { siteContent } from "../lib/site-content";

if (!import.meta.env.DEV) return new Response("Not found", { status: 404 });

const quote = siteContent.quotes.split(/\n\s*\n/).map((item) => item.trim()).find(Boolean);
---

<TerminalLayout title="Design Lab | Dellie">
  <main class="design-lab">
    <header class="lab-heading">
      <div>
        <p class="lab-kicker">d3llie@website <span>~/design-lab</span></p>
        <h1>Two directions. One terminal soul.</h1>
        <p class="lab-intro">
          Local design study only. The ambient concept has a CSS backdrop placeholder until you share an image.
        </p>
      </div>
      <a class="lab-back" href="/">← Back to current site</a>
    </header>

    <div class="concept-grid">
      <section class="concept" aria-labelledby="ambient-title">
        <div class="concept-heading">
          <div>
            <p class="concept-index">01 / ATMOSPHERIC</p>
            <h2 id="ambient-title">Ambient glass terminal</h2>
          </div>
          <span class="concept-tag">Image-led</span>
        </div>
        <p class="concept-note">
          A soft, blurred backdrop sets the mood; a readable glass terminal stays in focus.
        </p>

        <div class="ambient-preview">
          <div class="ambient-glow ambient-glow-one" aria-hidden="true"></div>
          <div class="ambient-glow ambient-glow-two" aria-hidden="true"></div>
          <div class="ambient-window">
            <div class="window-bar">
              <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>d3llie@website: ~</span>
              <span class="window-label">zsh</span>
            </div>
            <div class="ambient-content">
              <p class="prompt-line"><span>$</span> whoami</p>
              <h3>Hi, I'm Dellie<span class="cursor" aria-hidden="true">_</span></h3>
              <p class="ambient-role">
                Software developer at Commerce Bank, working with integrations, APIs, and event-driven systems.
              </p>
              <div class="ambient-actions">
                <a href="/resume">View resume <span aria-hidden="true">↗</span></a>
                <a href="/projects">Explore projects <span aria-hidden="true">→</span></a>
              </div>
              <div class="ambient-status">
                <span class="status-dot" aria-hidden="true"></span>
                <span>Currently building with APIs and event-driven systems</span>
              </div>
            </div>
          </div>
          <span class="image-slot-label">BACKDROP IMAGE SLOT</span>
        </div>

        <div class="concept-meta">
          <span>Best for: personality and atmosphere</span>
          <span>Needs: your image + contrast tuning</span>
        </div>
      </section>

      <section class="concept" aria-labelledby="workstation-title">
        <div class="concept-heading">
          <div>
            <p class="concept-index">02 / STRUCTURED</p>
            <h2 id="workstation-title">Developer workstation</h2>
          </div>
          <span class="concept-tag">Content-first</span>
        </div>
        <p class="concept-note">
          A tidy, app-like terminal workspace: clear hierarchy, useful panels, no decorative wallpaper.
        </p>

        <div class="workstation-preview">
          <div class="workstation-top">
            <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <span>DELLIE / PERSONAL SITE</span>
            <span class="workstation-version">v1.0</span>
          </div>
          <div class="workstation-nav" aria-label="Preview navigation">
            <span class="active">home</span>
            <span>projects</span>
            <span>writing</span>
            <a href="/resume">resume</a>
          </div>
          <div class="workstation-main">
            <p class="workstation-prompt"><span>d3llie@website</span> ~ $ ./introduce</p>
            <h3>Hi, I'm Dellie.</h3>
            <p class="workstation-role">
              Software developer at Commerce Bank, working with integrations, APIs, and event-driven systems.
            </p>
            <div class="workstation-actions">
              <a href="/projects">Explore projects <span aria-hidden="true">→</span></a>
              <a class="secondary-action" href="/resume">View resume</a>
            </div>
            <div class="workstation-panels">
              <article class="workstation-card">
                <p class="card-label"><span>01</span> / NOW</p>
                <h4>Working on systems that connect.</h4>
                <p>Integrations, APIs, and event-driven software at Commerce Bank.</p>
              </article>
              <article class="workstation-card quote-card">
                <p class="card-label"><span>02</span> / CURRENT THOUGHT</p>
                <blockquote>{quote ?? "A thought worth keeping close."}</blockquote>
              </article>
            </div>
          </div>
          <div class="workstation-status">
            <span><i aria-hidden="true"></i> Available for thoughtful collaborations</span>
            <span>local / personal</span>
          </div>
        </div>

        <div class="concept-meta">
          <span>Best for: readability and navigation</span>
          <span>Needs: polish and responsive tuning</span>
        </div>
      </section>
    </div>
  </main>
</TerminalLayout>

<style>
  .design-lab {
    --lab-bg: #101714;
    --lab-panel: #17211d;
    --lab-raised: #1d2b25;
    --lab-border: rgba(209, 229, 216, 0.13);
    --lab-text: #e4ede7;
    --lab-muted: #9eafa5;
    --lab-green: #a7d6a0;
    --lab-mint: #8bd1bb;
    box-sizing: border-box;
    color: var(--lab-text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    margin: 0 auto;
    max-width: 1440px;
    padding: clamp(1.25rem, 4vw, 3.5rem);
    width: 100%;
  }

  .lab-heading {
    align-items: end;
    border-bottom: 1px solid var(--lab-border);
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    margin: 0 auto 2rem;
    max-width: 1320px;
    padding-bottom: 1.5rem;
  }

  .lab-kicker,
  .concept-index,
  .card-label,
  .workstation-prompt,
  .workstation-nav,
  .workstation-top,
  .workstation-status,
  .window-bar,
  .prompt-line,
  .ambient-status,
  .image-slot-label {
    font-family: var(--font-terminal);
  }

  .lab-kicker {
    color: var(--lab-green);
    font-size: 0.82rem;
    margin: 0 0 0.75rem;
  }

  .lab-kicker span {
    color: var(--lab-muted);
  }

  .lab-heading h1 {
    font-size: clamp(1.8rem, 4vw, 3.1rem);
    letter-spacing: -0.045em;
    line-height: 1.08;
    margin: 0;
  }

  .lab-intro {
    color: var(--lab-muted);
    line-height: 1.6;
    margin: 0.8rem 0 0;
    max-width: 42rem;
  }

  .lab-back {
    border: 1px solid var(--lab-border);
    border-radius: 999px;
    color: var(--lab-text);
    flex: 0 0 auto;
    font-size: 0.9rem;
    padding: 0.7rem 1rem;
    transition: background-color 140ms ease, border-color 140ms ease;
  }

  .lab-back:hover {
    background: var(--lab-raised);
    border-color: rgba(167, 214, 160, 0.4);
    text-decoration: none;
  }

  .concept-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 1320px;
  }

  .concept {
    background: linear-gradient(160deg, rgba(28, 40, 34, 0.94), rgba(17, 25, 22, 0.98));
    border: 1px solid var(--lab-border);
    border-radius: 1.25rem;
    min-width: 0;
    padding: clamp(1rem, 2.2vw, 1.5rem);
  }

  .concept-heading {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
  }

  .concept-index {
    color: var(--lab-mint);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    margin: 0 0 0.35rem;
  }

  .concept-heading h2 {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0;
  }

  .concept-tag {
    border: 1px solid var(--lab-border);
    border-radius: 999px;
    color: var(--lab-muted);
    flex: 0 0 auto;
    font-size: 0.72rem;
    padding: 0.35rem 0.65rem;
  }

  .concept-note {
    color: var(--lab-muted);
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0.75rem 0 1.1rem;
    min-height: 2.8em;
  }

  .ambient-preview,
  .workstation-preview {
    border: 1px solid rgba(217, 234, 223, 0.12);
    border-radius: 0.9rem;
    min-height: 430px;
    overflow: hidden;
    position: relative;
  }

  .ambient-preview {
    align-items: center;
    background:
      radial-gradient(ellipse at 18% 22%, rgba(116, 161, 133, 0.32), transparent 40%),
      radial-gradient(ellipse at 85% 78%, rgba(64, 124, 132, 0.31), transparent 45%),
      linear-gradient(135deg, #263d36 0%, #172522 52%, #273841 100%);
    display: flex;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .ambient-preview::before {
    background:
      linear-gradient(120deg, rgba(12, 19, 17, 0.42), rgba(12, 18, 19, 0.15)),
      radial-gradient(ellipse at 35% 50%, rgba(188, 208, 175, 0.25), transparent 43%);
    content: "";
    inset: -12%;
    position: absolute;
    transform: scale(1.1);
  }

  .ambient-glow {
    border-radius: 50%;
    filter: blur(48px);
    height: 11rem;
    opacity: 0.48;
    position: absolute;
    width: 11rem;
  }

  .ambient-glow-one {
    background: #759d7a;
    left: -3rem;
    top: 2rem;
  }

  .ambient-glow-two {
    background: #4a8390;
    bottom: 1rem;
    right: -3rem;
  }

  .ambient-window {
    backdrop-filter: blur(18px);
    background: rgba(12, 19, 18, 0.72);
    border: 1px solid rgba(226, 242, 231, 0.27);
    border-radius: 0.8rem;
    box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.3);
    max-width: 32rem;
    overflow: hidden;
    position: relative;
    width: 100%;
    z-index: 1;
  }

  .window-bar {
    align-items: center;
    background: rgba(222, 237, 228, 0.07);
    border-bottom: 1px solid rgba(226, 242, 231, 0.13);
    color: #b6c8bc;
    display: grid;
    font-size: 0.7rem;
    grid-template-columns: 1fr auto 1fr;
    padding: 0.75rem 0.9rem;
  }

  .window-dots {
    display: flex;
    gap: 0.34rem;
  }

  .window-dots i {
    background: #70867a;
    border-radius: 50%;
    height: 0.48rem;
    width: 0.48rem;
  }

  .window-dots i:first-child {
    background: #d7867d;
  }

  .window-dots i:nth-child(2) {
    background: #ddb97b;
  }

  .window-dots i:nth-child(3) {
    background: #8abf8d;
  }

  .window-label {
    color: #91a69a;
    justify-self: end;
  }

  .ambient-content {
    padding: clamp(1.2rem, 4vw, 2rem);
  }

  .prompt-line {
    color: #afc5b7;
    font-size: 0.78rem;
    margin: 0 0 1rem;
  }

  .prompt-line span,
  .workstation-prompt span {
    color: var(--lab-green);
  }

  .ambient-content h3,
  .workstation-main h3 {
    color: #f0f5f0;
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    margin: 0;
  }

  .cursor {
    color: var(--lab-green);
    font-family: var(--font-terminal);
    font-weight: 400;
  }

  .ambient-role {
    color: #c1d0c6;
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0.9rem 0 1.4rem;
    max-width: 31rem;
  }

  .ambient-actions,
  .workstation-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .ambient-actions a,
  .workstation-actions a {
    background: var(--lab-green);
    border: 1px solid var(--lab-green);
    border-radius: 0.55rem;
    color: #132018;
    font-size: 0.83rem;
    font-weight: 650;
    padding: 0.67rem 0.85rem;
    transition: transform 140ms ease, filter 140ms ease;
  }

  .ambient-actions a:hover,
  .workstation-actions a:hover {
    filter: brightness(1.06);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .ambient-actions a span,
  .workstation-actions a span {
    margin-left: 0.35rem;
  }

  .workstation-actions .secondary-action {
    background: transparent;
    border-color: rgba(201, 221, 207, 0.26);
    color: var(--lab-text);
    font-weight: 500;
  }

  .ambient-status {
    align-items: center;
    border-top: 1px solid rgba(226, 242, 231, 0.15);
    color: #afc2b5;
    display: flex;
    font-size: 0.68rem;
    gap: 0.55rem;
    line-height: 1.5;
    margin-top: 1.45rem;
    padding-top: 0.85rem;
  }

  .status-dot,
  .workstation-status i {
    background: #8acb91;
    border-radius: 50%;
    box-shadow: 0 0 0.6rem rgba(138, 203, 145, 0.4);
    flex: 0 0 auto;
    height: 0.42rem;
    width: 0.42rem;
  }

  .image-slot-label {
    bottom: 0.75rem;
    color: rgba(244, 249, 245, 0.66);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    position: absolute;
    right: 0.8rem;
    z-index: 1;
  }

  .workstation-preview {
    background: #101714;
  }

  .workstation-top {
    align-items: center;
    background: #19221e;
    border-bottom: 1px solid var(--lab-border);
    color: #acbdb2;
    display: grid;
    font-size: 0.62rem;
    grid-template-columns: 1fr auto 1fr;
    letter-spacing: 0.035em;
    padding: 0.8rem 0.9rem;
  }

  .workstation-top .window-dots {
    gap: 0.27rem;
  }

  .workstation-top .window-dots i {
    height: 0.38rem;
    width: 0.38rem;
  }

  .workstation-version {
    color: #7f9285;
    justify-self: end;
  }

  .workstation-nav {
    align-items: center;
    border-bottom: 1px solid var(--lab-border);
    color: #96a99c;
    display: flex;
    font-size: 0.68rem;
    gap: clamp(0.65rem, 2vw, 1.25rem);
    overflow-x: auto;
    padding: 0.7rem 1rem;
  }

  .workstation-nav span,
  .workstation-nav a {
    flex: 0 0 auto;
  }

  .workstation-nav .active {
    color: var(--lab-green);
  }

  .workstation-nav a {
    color: #c4d2c8;
  }

  .workstation-main {
    padding: clamp(1rem, 2.6vw, 1.6rem);
  }

  .workstation-prompt {
    color: #a6b8ac;
    font-size: 0.69rem;
    margin: 0 0 0.8rem;
  }

  .workstation-role {
    color: #abb9b0;
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0.75rem 0 1.1rem;
    max-width: 32rem;
  }

  .workstation-actions a {
    font-size: 0.77rem;
    padding: 0.58rem 0.75rem;
  }

  .workstation-panels {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1.15rem;
  }

  .workstation-card {
    background: var(--lab-panel);
    border: 1px solid var(--lab-border);
    border-radius: 0.65rem;
    min-width: 0;
    padding: 0.8rem;
  }

  .card-label {
    color: #93aa9b;
    font-size: 0.58rem;
    letter-spacing: 0.045em;
    margin: 0 0 0.55rem;
  }

  .card-label span {
    color: var(--lab-green);
  }

  .workstation-card h4 {
    color: #e1ece4;
    font-size: 0.88rem;
    letter-spacing: -0.02em;
    line-height: 1.4;
    margin: 0;
  }

  .workstation-card > p:last-child {
    color: #9eafa5;
    font-size: 0.75rem;
    line-height: 1.5;
    margin: 0.45rem 0 0;
  }

  .quote-card blockquote {
    border-left: 2px solid #9dbf8e;
    color: #d0dbd3;
    font-size: 0.76rem;
    line-height: 1.55;
    margin: 0;
    max-height: 5.2em;
    overflow: hidden;
    padding-left: 0.65rem;
  }

  .workstation-status {
    align-items: center;
    background: #19221e;
    border-top: 1px solid var(--lab-border);
    color: #96a99c;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.59rem;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    padding: 0.7rem 0.9rem;
  }

  .workstation-status > span:first-child {
    align-items: center;
    display: inline-flex;
    gap: 0.45rem;
  }

  .workstation-status i {
    height: 0.36rem;
    width: 0.36rem;
  }

  .concept-meta {
    color: #91a297;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.72rem;
    gap: 0.35rem 1.25rem;
    justify-content: space-between;
    padding: 0.85rem 0.15rem 0;
  }

  .design-lab a:focus-visible {
    outline: 3px solid #e8c889;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .concept-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 700px;
    }

    .concept-note {
      min-height: 0;
    }

    .ambient-preview,
    .workstation-preview {
      min-height: 390px;
    }
  }

  @media (max-width: 560px) {
    .lab-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .lab-back {
      font-size: 0.82rem;
    }

    .concept-heading {
      align-items: flex-start;
    }

    .concept-tag {
      font-size: 0.64rem;
      margin-top: 0.25rem;
    }

    .ambient-preview,
    .workstation-preview {
      min-height: 0;
    }

    .ambient-preview {
      padding: 1rem 0.7rem 2rem;
    }

    .ambient-content {
      padding: 1.2rem;
    }

    .ambient-actions a,
    .workstation-actions a {
      font-size: 0.75rem;
    }

    .workstation-nav {
      gap: 0.8rem;
    }

    .workstation-panels {
      grid-template-columns: minmax(0, 1fr);
    }

    .workstation-status {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .design-lab *,
    .design-lab *::before,
    .design-lab *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
