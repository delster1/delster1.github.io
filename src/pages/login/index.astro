---
export const prerender = false;
import { D3_EMAIL } from "astro:env/server";
import TerminalLayout from "../../layouts/TerminalLayout.astro";
import { isAdminEmail } from "../../lib/access-control";

const session = Astro.locals.session ?? null;
const user = Astro.locals.user ?? null;
const isAdmin = user ? isAdminEmail(user.email, D3_EMAIL) : false;
---

<TerminalLayout title="d3llie - login">
  <main class="mx-auto w-full max-w-2xl">
    <p class="text-green-400">
      <span class="text-yellow-300">d3llie@website</span>
      <span class="text-blue-400"> ~ </span>
      <span>$</span>
      &nbsp;./auth --login
    </p>

    <section
      box-="round"
      shear-="top"
      class="mx-auto mt-8 w-full max-w-md"
      style="--box-bg: var(--bg1)"
      aria-labelledby="login-title"
    >
      <div class="header">
        <span is-="badge" variant-="yellow">Owner access</span>
      </div>
      <div class="space-y-4 p-5 text-center">
        <h1 id="login-title" class="text-xl">Sign in</h1>
        {session && user ? (
          <>
            <p>Signed in as <span class="text-blue-400">{user.email}</span></p>
            {isAdmin ? (
              <>
                <p class="text-yellow-300">Welcome back, Dellie.</p>
                <a class="btn inline-block" href="/dashboard">Open dashboard</a>
              </>
            ) : (
              <p role="alert">This account does not have owner access.</p>
            )}
            <button id="sign-out" class="btn w-full" type="button" variant-="yellow">
              Sign out
            </button>
            <p id="auth-feedback" role="status" aria-live="polite"></p>
          </>
        ) : (
          <>
            <p>Owner sign-in is available through the site’s GitHub account.</p>
            <button id="github-sign-in" class="btn w-full" type="button" variant-="yellow">
              Continue with GitHub
            </button>
            <p id="auth-feedback" role="status" aria-live="polite"></p>
          </>
        )}
      </div>
    </section>

    <p class="mt-6 text-center text-sm opacity-70">
      <a href="/" class="hover:underline">← Back to home</a>
    </p>
  </main>

  <script>
    import { authClient } from "../../lib/auth-client";

    const feedback = document.getElementById("auth-feedback");
    const signInButton = document.getElementById("github-sign-in");
    const signOutButton = document.getElementById("sign-out");

    signInButton?.addEventListener("click", async () => {
      if (feedback) feedback.textContent = "";
      try {
        const { error } = await authClient.signIn.social({
          provider: "github",
          callbackURL: "/dashboard",
        });
        if (error && feedback) feedback.textContent = error.message ?? "GitHub sign-in failed.";
      } catch (error) {
        if (feedback) {
          feedback.textContent =
            error instanceof Error ? error.message : "Unable to start GitHub sign-in.";
        }
      }
    });

    signOutButton?.addEventListener("click", async () => {
      try {
        const { error } = await authClient.signOut({
          fetchOptions: {
            onSuccess: () => window.location.assign("/"),
          },
        });
        if (error && feedback) feedback.textContent = error.message ?? "Sign out failed.";
      } catch (error) {
        if (feedback) {
          feedback.textContent =
            error instanceof Error ? error.message : "Unable to sign out.";
        }
      }
    });
  </script>
</TerminalLayout>
