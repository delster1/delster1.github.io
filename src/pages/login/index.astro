---
export const prerender = false;
import TerminalLayout from "../../layouts/TerminalLayout.astro";
import { env } from "cloudflare:workers";
import { isAdminLoginConfigured } from "../../lib/admin-auth";

const isAdmin = Astro.locals.isAdmin;
const loginConfigured = isAdminLoginConfigured(env);
const loginError = Astro.url.searchParams.get("error");
Astro.response.headers.set("Cache-Control", "no-store");
---

<TerminalLayout title="d3llie - login">
  <main class="mx-auto w-full max-w-2xl">
    <p class="text-green-400">
      <span class="text-yellow-300">d3llie@website</span>
      <span class="text-blue-400"> ~ </span>
      <span>$</span>
      &nbsp;./auth --login
    </p>

    <section
      box-="round"
      shear-="top"
      class="mx-auto mt-8 w-full max-w-md"
      style="--box-bg: var(--bg1)"
      aria-labelledby="login-title"
    >
      <div class="header">
        <span is-="badge" variant-="yellow">Owner access</span>
      </div>
      <div class="space-y-4 p-5 text-center">
        <h1 id="login-title" class="text-xl">Sign in</h1>
        {isAdmin ? (
          <>
            <p>Signed in as <span class="text-blue-400">delster1</span></p>
            <p class="text-yellow-300">Welcome back, Dellie.</p>
            <a class="btn inline-block" href="/dashboard">Open dashboard</a>
            <form action="/api/admin/logout" method="post">
              <button class="btn w-full" type="submit" variant-="yellow">Sign out</button>
            </form>
          </>
        ) : (
          <>
            <p>Sign in to manage the site’s default background.</p>
            {!loginConfigured && (
              <p class="text-red-300" role="alert">
                Admin sign-in is not configured. Set ADMIN_PASSWORD and AUTH_SECRET in your deployment environment.
              </p>
            )}
            {loginError === "invalid" && (
              <p class="text-red-300" role="alert">Incorrect username or password.</p>
            )}
            {loginError === "unavailable" && loginConfigured && (
              <p class="text-red-300" role="alert">
                Admin sign-in is not configured. Set ADMIN_PASSWORD and AUTH_SECRET in your deployment environment.
              </p>
            )}
            <form action="/api/admin/login" method="post" class="space-y-4 text-left">
              <label class="block" for="username">
                <span class="mb-1 block">Username</span>
                <input
                  class="w-full"
                  id="username"
                  name="username"
                  type="text"
                  autocomplete="username"
                  required
                />
              </label>
              <label class="block" for="password">
                <span class="mb-1 block">Password</span>
                <input
                  class="w-full"
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                />
              </label>
              <button class="btn w-full" type="submit" variant-="yellow">Sign in</button>
            </form>
          </>
        )}
      </div>
    </section>

    <p class="mt-6 text-center text-sm opacity-70">
      <a href="/" class="hover:underline">← Back to home</a>
    </p>
  </main>
</TerminalLayout>
