---
import TerminalLayout from "../layouts/TerminalLayout.astro";
import { XMLParser } from "fast-xml-parser";
import { marked } from "marked";
import { siteContent } from "../lib/site-content";

const quotes = siteContent.quotes
.split(/\n\s*\n/)
.map((item) => item.trim())
.filter(Boolean);
const quote = quotes.length
? quotes[Math.floor(Math.random() * quotes.length)]
: "Quote temporarily unavailable.";
const nowContent = await marked.parse(
siteContent.now.trim() || "The Now page is temporarily unavailable. Please check back soon."
);

let books = [];
try {
    const response = await fetch('https://www.goodreads.com/review/list_rss/134911869?shelf=currently-reading');
    if (response.ok) {
        const xmlData = await response.text();
        const parser = new XMLParser();
        const jsonObj = parser.parse(xmlData);
        const items = jsonObj.rss.channel.item;
        if (items) {
            books = Array.isArray(items) ? items : [items];
        }
    }
} catch (error) {
    console.error('Error fetching books:', error);
}

import banner from "../banner.txt?raw";
---

<TerminalLayout title="Dellie | Home">
    <main class="home-shell">
        <div class="terminal-prompt" aria-label="Terminal prompt">
            <span class="text-yellow-300">d3llie@website</span>
            <span class="text-blue-400"> ~ </span>
            <span>$ ./website-tui</span>
        </div>
        <div box-="round" class="home-banner-frame" title="Dellie">
            <pre class="banner" aria-label="Dellie ASCII banner">{banner}</pre>
        </div>

        <div class="home-grid">
            <section box-="round" class="home-panel" aria-labelledby="about-heading" style="--box-bg: var(--bg1)">
                <div class="header">
                    <h1 id="about-heading" is-="badge" variant-="yellow">Hi, I'm Dellie</h1>
                </div>
                <p class="home-intro">
                    Software developer at Commerce Bank, working with integrations, APIs, and event-driven systems.
                </p>
                <blockquote class="home-quote">{quote}</blockquote>
                <details class="home-details">
                    <summary>Currently reading</summary>
                    {books.length > 0 ? (
                        <ul class="home-reading-list">
                            {books.map((book) => (
                                <li class="home-book">
                                    {book.book_small_image_url && (
                                        <img src={book.book_small_image_url} alt="" loading="lazy" />
                                    )}
                                    <div>
                                        <a href={book.link} target="_blank" rel="noopener noreferrer">
                                            {book.title}
                                        </a>
                                        <div class="text-sm">
                                            <span class="text-gray-400">by </span>
                                            <span class="text-yellow-200">{book.author_name}</span>
                                        </div>
                                    </div>
                                </li>
                            ))}
                        </ul>
                    ) : (
                        <p class="muted">Reading list is temporarily unavailable.</p>
                    )}
                    <a href="https://www.goodreads.com/user/show/134911869-delroy-wright" target="_blank" rel="noopener noreferrer">
                        View my Goodreads
                    </a>
                </details>
            </section>

            <section box-="round" class="home-panel" id="now" aria-labelledby="now-heading" style="--box-bg: var(--bg1)">
                <div class="header">
                    <h2 id="now-heading" is-="badge" variant-="yellow">Now</h2>
                </div>
                <div class="now-content" set:html={nowContent} />
                <a class="home-subtle-link" href="https://nownownow.com/about">What is a now page?</a>
            </section>
        </div>
        <section box-="round" class="home-links" aria-labelledby="links-heading" style="--box-bg: var(--bg1)">
            <div class="header">
                <h2 id="links-heading" is-="badge" variant-="yellow">Explore and connect</h2>
            </div>
            <div class="home-link-grid">
                <a class="home-link" box-="round" href="https://github.com/delster1" target="_blank" rel="noopener noreferrer">
                    <span>GitHub</span>
                    <span class="home-link-arrow" aria-hidden="true">↗</span>
                </a>
                <a class="home-link" box-="round" href="https://www.linkedin.com/in/delroy-wright-440b35210/" target="_blank" rel="noopener noreferrer">
                    <span>LinkedIn</span>
                    <span class="home-link-arrow" aria-hidden="true">↗</span>
                </a>
                <a class="home-link" box-="round" href="/about">
                    <span>About</span>
                    <span class="home-link-arrow" aria-hidden="true">→</span>
                </a>
                <a class="home-link" box-="round" href="/projects">
                    <span>Projects</span>
                    <span class="home-link-arrow" aria-hidden="true">→</span>
                </a>
                <a class="home-link" box-="round" href="/blog">
                    <span>Writing</span>
                    <span class="home-link-arrow" aria-hidden="true">→</span>
                </a>
                <a class="home-link" box-="round" href="/resume">
                    <span>Resume</span>
                    <span class="home-link-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </section>

        <nav class="statusline home-nav" aria-label="Site navigation">
            <div class="status-left">
                <a class="seg" href="/about">about</a>
                <a class="seg" href="/projects">projects</a>
                <a class="seg" href="/blog">blog</a>
                <a class="seg" href="/resume">resume</a>
            </div>
            <div class="status-right">
                <a class="seg" href="/login">admin login</a>
            </div>
        </nav>
    </main>
</TerminalLayout>

<style>
    .home-shell {
        display: grid;
        gap: 1rem;
        margin-inline: auto;
        max-width: 74rem;
        min-width: 0;
        width: 100%;
    }

    .terminal-prompt {
        font-size: clamp(0.9rem, 2vw, 1.15rem);
        overflow-wrap: anywhere;
    }

    .home-banner-frame {
        min-width: 0;
        overflow-x: auto;
    }

    .banner {
        background: var(--bg1);
        border-radius: 0.5rem;
        color: var(--terminal-text);
        font-family: "Comic Mono", monospace;
        font-size: clamp(0.42rem, 1.35vw, 1rem);
        letter-spacing: -0.02em;
        line-height: 1;
        margin: 0;
        padding: clamp(0.75rem, 2vw, 1.25rem);
        white-space: pre;
        width: max-content;
    }

    .home-grid {
        align-items: start;
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .home-panel,
    .home-links {
        min-width: 0;
        padding: clamp(1rem, 2.5vw, 1.5rem);
    }

    .home-panel h1,
    .home-panel h2,
    .home-links h2 {
        font-size: 1.1em;
        margin: 0;
    }

    .home-intro {
        margin: 1rem 0;
    }

    .home-quote {
        border-inline-start: 3px solid var(--yellow);
        color: var(--terminal-text, var(--text));
        margin: 1.25rem 0;
        padding: 0.25rem 0 0.25rem 1rem;
    }

    .home-details summary {
        color: var(--blue);
        cursor: pointer;
        padding: 0.5rem 0;
    }

    .home-reading-list {
        list-style: none;
        margin: 0.75rem 0;
        padding: 0;
    }

    .home-book {
        align-items: start;
        display: flex;
        gap: 0.75rem;
        margin-block: 0.75rem;
        min-width: 0;
    }

    .home-book img {
        border: 1px solid var(--bg3);
        flex: 0 0 3rem;
        height: auto;
        width: 3rem;
    }

    .home-book > div {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .home-subtle-link {
        display: inline-block;
        margin-top: 0.75rem;
    }

    .home-link-grid {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
        margin-top: 1rem;
    }

    .home-link {
        align-items: center;
        display: flex;
        justify-content: space-between;
        min-height: 3.5rem;
        padding: 0.85rem 1rem;
        text-decoration: none;
    }

    .home-link-arrow {
        color: var(--yellow);
    }

    .home-nav.statusline {
        flex-wrap: wrap;
        gap: 0.5rem;
        overflow: visible;
        white-space: normal;
    }

    .home-nav .status-left,
    .home-nav .status-right {
        flex-wrap: wrap;
    }

    @media (max-width: 700px) {
        .home-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .banner {
            font-size: clamp(0.36rem, 1.6vw, 0.7rem);
        }
    }
</style>
