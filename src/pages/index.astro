---
import TerminalLayout from "../layouts/TerminalLayout.astro";
import { env } from "cloudflare:workers";
import { marked } from "marked";
import { siteContent } from "../lib/site-content";
import { fetchGitHubSiteContent } from "../lib/github-site-content";
import { goodreadsProfileUrl } from "../lib/goodreads";

let pageContent = siteContent;
const githubContentToken = env.GITHUB_CONTENT_TOKEN;
if (githubContentToken) {
  try {
    pageContent = {
      ...siteContent,
      ...(await fetchGitHubSiteContent(githubContentToken)),
    };
  } catch (error) {
    console.error("Could not refresh the Now page and quotes from GitHub.", error);
  }
}

const quotes = pageContent.quotes
  .split(/\n\s*\n/)
  .map((item) => item.trim())
  .filter(Boolean);
const quote = quotes.length
  ? quotes[Math.floor(Math.random() * quotes.length)]
  : "Quote temporarily unavailable.";
const nowContent = await marked.parse(
  pageContent.now.trim() || "The Now page is temporarily unavailable. Please check back soon."
);
const goodreads = siteContent.goodreads;
---

<TerminalLayout title="Dellie | Home">
  <main class="home-shell">
    <header class="home-topbar">
      <p class="terminal-prompt" aria-label="Terminal prompt">
        <span>d3llie@website</span> <b>~</b> $ ./website-tui
      </p>
      <a class="appearance-link" href="/appearance">
        <span class="appearance-icon" aria-hidden="true">◐</span>
        Appearance
      </a>
    </header>

    <section class="ambient-hero" aria-labelledby="about-heading">
      <div class="hero-window-bar">
        <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="window-path">~/home</span>
        <span class="hero-state"><i aria-hidden="true"></i> ONLINE</span>
      </div>
      <div class="hero-content">
        <p class="hero-command"><span>d3llie@website</span> ~ $ whoami</p>
        <h1 id="about-heading">Hi, I'm Dellie<span class="hero-cursor" aria-hidden="true">_</span></h1>
        <p class="hero-intro">
          Software developer at Commerce Bank, working with integrations, APIs, and event-driven systems.
        </p>
        <div class="hero-actions">
          <a class="hero-primary" href="/resume">View resume <span aria-hidden="true">↗</span></a>
          <a class="hero-secondary" href="/projects">Explore projects <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-footer">
        <span class="hero-footer-dot" aria-hidden="true"></span>
        <span>Building things that help systems work together</span>
        <a href="/appearance">Choose a background</a>
      </div>
    </section>

    <div class="home-grid">
      <section class="home-panel" id="now" aria-labelledby="now-heading">
        <div class="panel-heading">
          <p class="section-kicker">01 / CURRENT STATUS</p>
          <span class="panel-command">cat now.md</span>
        </div>
        <h2 id="now-heading">Now</h2>
        <div class="now-content" set:html={nowContent} />
        <a class="home-subtle-link" href="https://nownownow.com/about">What is a now page? <span aria-hidden="true">↗</span></a>
      </section>

      <section class="home-panel thoughts-panel" aria-labelledby="thoughts-heading">
        <div class="panel-heading">
          <p class="section-kicker">02 / RANDOM QUOTE</p>
          <span class="panel-command">quote --random</span>
        </div>
        <h2 id="thoughts-heading">A random quote</h2>
        <blockquote class="home-quote">{quote}</blockquote>
        <div class="home-reading">
          <p class="home-reading-label">CURRENTLY READING</p>
          {goodreads.kind === "available" && goodreads.book ? (
            <p class="home-reading-title">
              {goodreads.book.title}
              {goodreads.book.author && <span>by {goodreads.book.author}</span>}
            </p>
          ) : goodreads.kind === "available" ? (
            <p class="muted">Goodreads isn't exposing a current book to visitors. Check your profile privacy setting.</p>
          ) : (
            <p class="muted">Goodreads is unavailable right now.</p>
          )}
          <a class="home-subtle-link" href={goodreadsProfileUrl} target="_blank" rel="noopener noreferrer">
            My Goodreads profile <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </div>

    <section class="home-links" aria-labelledby="links-heading">
      <div class="panel-heading">
        <div>
          <p class="section-kicker">03 / QUICK ACCESS</p>
          <h2 id="links-heading">Explore and connect</h2>
        </div>
        <span class="panel-command">ls ~/links</span>
      </div>
      <div class="home-link-grid">
        <a class="home-link" href="https://github.com/delster1" target="_blank" rel="noopener noreferrer">
          <span><small>CODE</small>GitHub</span><span class="home-link-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="home-link" href="https://www.linkedin.com/in/delroy-wright-440b35210/" target="_blank" rel="noopener noreferrer">
          <span><small>NETWORK</small>LinkedIn</span><span class="home-link-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="home-link" href="/about">
          <span><small>PROFILE</small>About</span><span class="home-link-arrow" aria-hidden="true">→</span>
        </a>
        <a class="home-link" href="/projects">
          <span><small>BUILD</small>Projects</span><span class="home-link-arrow" aria-hidden="true">→</span>
        </a>
        <a class="home-link" href="/blogs">
          <span><small>NOTES</small>Writing</span><span class="home-link-arrow" aria-hidden="true">→</span>
        </a>
        <a class="home-link" href="/resume">
          <span><small>DOCUMENT</small>Resume</span><span class="home-link-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <nav class="statusline home-nav" aria-label="Site navigation">
      <div class="status-left">
        <a class="seg" href="/about">about</a>
        <a class="seg" href="/projects">projects</a>
        <a class="seg" href="/blogs">blog</a>
        <a class="seg" href="/resume">resume</a>
        <a class="seg" href="/appearance">appearance</a>
      </div>
      <div class="status-right">
        <a class="seg" href="/login">admin login</a>
      </div>
    </nav>
  </main>
</TerminalLayout>

<style>
  .home-shell {
    color: #e8eee9;
    display: grid;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    gap: 1.15rem;
    margin-inline: auto;
    max-width: 76rem;
    min-width: 0;
    width: 100%;
  }

  .home-topbar,
  .hero-window-bar,
  .hero-footer,
  .panel-heading,
  .home-nav {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .home-topbar {
    gap: 1rem;
    min-width: 0;
  }

  .terminal-prompt,
  .hero-command,
  .hero-window-bar,
  .hero-footer,
  .panel-command,
  .section-kicker {
    font-family: var(--font-terminal);
  }

  .terminal-prompt {
    color: #b7c8bd;
    font-size: clamp(0.7rem, 1.8vw, 0.85rem);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .terminal-prompt span,
  .hero-command span {
    color: var(--site-accent);
  }

  .terminal-prompt b {
    color: #90a197;
    font-weight: 400;
  }

  .appearance-link {
    align-items: center;
    background: rgba(15, 22, 18, 0.75);
    border: 1px solid color-mix(in srgb, var(--site-accent) 32%, transparent);
    border-radius: 999px;
    color: #e8eee9;
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 0.78rem;
    gap: 0.45rem;
    padding: 0.48rem 0.75rem;
  }

  .appearance-link:hover {
    background: var(--site-panel-tint);
    text-decoration: none;
  }

  .appearance-icon {
    color: var(--site-accent);
    font-size: 1rem;
  }

  .ambient-hero,
  .home-panel,
  .home-links {
    backdrop-filter: blur(16px);
    background:
      linear-gradient(135deg, rgba(17, 26, 21, 0.91), rgba(10, 15, 13, 0.88)),
      var(--site-wallpaper, none);
    border: 1px solid color-mix(in srgb, var(--site-accent) 24%, rgba(231, 240, 233, 0.14));
    border-radius: 1rem;
    box-shadow: 0 1.1rem 3rem rgba(0, 0, 0, 0.16);
    min-width: 0;
  }

  .ambient-hero {
    background: linear-gradient(135deg, rgba(17, 26, 21, 0.78), rgba(10, 15, 13, 0.7));
    overflow: hidden;
    position: relative;
  }

  .ambient-hero::before {
    background: radial-gradient(ellipse at 82% 18%, var(--site-glow), transparent 55%);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .hero-window-bar {
    background: rgba(7, 11, 9, 0.48);
    border-bottom: 1px solid rgba(224, 238, 227, 0.12);
    color: #a9b8ae;
    font-size: 0.68rem;
    gap: 1rem;
    min-height: 2.8rem;
    padding: 0 1.1rem;
    position: relative;
  }

  .window-dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .window-dots i {
    background: #d78378;
    border-radius: 50%;
    height: 0.48rem;
    width: 0.48rem;
  }

  .window-dots i:nth-child(2) {
    background: #d9b36f;
  }

  .window-dots i:nth-child(3) {
    background: #82b984;
  }

  .window-path {
    color: #c1ccc4;
  }

  .hero-state {
    align-items: center;
    color: #9eb4a3;
    display: inline-flex;
    font-size: 0.62rem;
    gap: 0.4rem;
    justify-self: end;
  }

  .hero-state i,
  .hero-footer-dot {
    background: #8bc393;
    border-radius: 50%;
    box-shadow: 0 0 0.65rem rgba(139, 195, 147, 0.4);
    height: 0.4rem;
    width: 0.4rem;
  }

  .hero-content {
    margin: 0 auto;
    max-width: 55rem;
    padding: clamp(2.2rem, 7vw, 5rem) clamp(1.25rem, 5vw, 4rem);
    position: relative;
  }

  .hero-command {
    color: #b2c2b8;
    font-size: clamp(0.72rem, 1.6vw, 0.88rem);
    margin: 0 0 1rem;
  }

  .hero-content h1 {
    color: #f0f5f1;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(2.4rem, 7.5vw, 5rem);
    font-weight: 680;
    letter-spacing: -0.065em;
    line-height: 1;
    margin: 0;
  }

  .hero-cursor {
    color: var(--site-accent);
    font-family: var(--font-terminal);
    font-weight: 400;
    padding-left: 0.08em;
  }

  .hero-intro {
    color: #c1ccc5;
    font-size: clamp(1rem, 2.1vw, 1.2rem);
    line-height: 1.7;
    margin: 1.1rem 0 1.6rem;
    max-width: 44rem;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .hero-actions a {
    align-items: center;
    border: 1px solid var(--site-accent);
    border-radius: 0.6rem;
    display: inline-flex;
    font-size: 0.88rem;
    font-weight: 650;
    gap: 0.45rem;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.65rem 1rem;
    transition: filter 140ms ease, transform 140ms ease;
  }

  .hero-actions a:hover {
    filter: brightness(1.08);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .hero-primary {
    background: var(--site-accent);
    color: var(--site-accent-ink) !important;
  }

  .hero-secondary {
    background: rgba(10, 15, 13, 0.24);
    color: #e8eee9 !important;
  }

  .hero-footer {
    background: rgba(7, 11, 9, 0.36);
    border-top: 1px solid rgba(224, 238, 227, 0.1);
    color: #a7b6ac;
    flex-wrap: wrap;
    font-size: 0.66rem;
    gap: 0.65rem 1rem;
    justify-content: flex-start;
    min-height: 2.8rem;
    padding: 0.55rem 1.25rem;
    position: relative;
  }

  .hero-footer a {
    color: var(--site-accent);
    margin-left: auto;
  }

  .home-grid {
    align-items: stretch;
    display: grid;
    gap: 1.15rem;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  }

  .home-panel,
  .home-links {
    background: var(--site-panel-tint);
    padding: clamp(1.15rem, 3vw, 1.7rem);
  }

  .panel-heading {
    align-items: flex-start;
    gap: 0.8rem;
    margin-bottom: 0.55rem;
  }

  .section-kicker {
    color: var(--site-accent);
    font-size: 0.65rem;
    letter-spacing: 0.045em;
    margin: 0;
  }

  .panel-command {
    color: #8fa197;
    font-size: 0.63rem;
    text-align: right;
  }

  .home-panel h2,
  .home-links h2 {
    color: #e8eee9;
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
    margin: 0.45rem 0 0.8rem;
  }

  .now-content {
    color: #c2cec5;
    font-size: 0.95rem;
    font-family: inherit;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .now-content p {
    margin: 0 0 0.8rem;
  }

  .now-content h1,
  .now-content h2,
  .now-content h3 {
    color: #e4ede6;
    font-family: inherit;
    font-size: 1.08rem;
    margin: 1rem 0 0.45rem;
  }

  .now-content ul,
  .now-content ol {
    margin: 0.6rem 0 0.9rem;
    padding-left: 1.35rem;
  }

  .now-content li {
    margin: 0.3rem 0;
  }

  .now-content a,
  .home-subtle-link {
    color: var(--site-accent);
  }

  .home-subtle-link {
    display: inline-block;
    font-size: 0.82rem;
    margin-top: 0.3rem;
  }

  .home-quote {
    border-left: 2px solid var(--site-accent);
    color: #d5ded8;
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    line-height: 1.75;
    margin: 1rem 0 1.35rem;
    padding: 0.15rem 0 0.15rem 1rem;
  }

  .home-reading {
    border-top: 1px solid rgba(224, 238, 227, 0.13);
    margin-top: 0.9rem;
    padding-top: 0.7rem;
  }

  .home-reading-label {
    color: #a5b4aa;
    font: 0.7rem/1.4 var(--font-terminal);
    letter-spacing: 0.06em;
    margin: 0;
  }

  .home-reading-title {
    color: #e8eee9;
    display: grid;
    font-size: 0.9rem;
    font-weight: 600;
    gap: 0.15rem;
    margin: 0.35rem 0 0;
    overflow-wrap: anywhere;
  }

  .home-reading-title span,
  .muted {
    color: #a5b4aa;
    font-size: 0.8rem;
    font-weight: 400;
  }

  .home-links .panel-heading {
    align-items: center;
    margin-bottom: 1rem;
  }

  .home-links h2 {
    margin-bottom: 0;
  }

  .home-link-grid {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
  }

  .home-link {
    align-items: center;
    background: rgba(7, 12, 9, 0.28);
    border: 1px solid rgba(224, 238, 227, 0.12);
    border-radius: 0.65rem;
    color: #e3ebe5;
    display: flex;
    justify-content: space-between;
    min-height: 4rem;
    padding: 0.7rem 0.9rem;
    transition: background-color 140ms ease, border-color 140ms ease;
  }

  .home-link:hover {
    background: color-mix(in srgb, var(--site-accent) 9%, rgba(7, 12, 9, 0.58));
    border-color: color-mix(in srgb, var(--site-accent) 48%, transparent);
    text-decoration: none;
  }

  .home-link > span:first-child {
    display: grid;
    gap: 0.18rem;
  }

  .home-link small {
    color: #95a69b;
    font-family: var(--font-terminal);
    font-size: 0.56rem;
    letter-spacing: 0.05em;
  }

  .home-link-arrow {
    color: var(--site-accent);
    font-size: 1rem;
  }

  .home-nav.statusline {
    background: rgba(12, 18, 15, 0.88);
    border: 1px solid rgba(224, 238, 227, 0.12);
    border-radius: 0.65rem;
    flex-wrap: wrap;
    gap: 0.35rem;
    overflow: visible;
    padding: 0.3rem;
    white-space: normal;
  }

  .home-nav .status-left,
  .home-nav .status-right {
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .home-nav .seg {
    background: transparent;
    border-radius: 0.35rem;
    color: #bdc9c1;
    font-size: 0.68rem;
    padding: 0.55rem 0.65rem;
  }

  .home-nav .seg:hover {
    background: color-mix(in srgb, var(--site-accent) 12%, transparent);
    color: #f0f5f1;
    filter: none;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .home-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-content {
      padding-block: clamp(2rem, 9vw, 3.5rem);
    }
  }

  @media (max-width: 480px) {
    .home-shell {
      gap: 0.85rem;
    }

    .home-topbar {
      align-items: flex-start;
    }

    .appearance-link {
      font-size: 0.72rem;
      padding: 0.4rem 0.6rem;
    }

    .hero-window-bar {
      min-height: 2.5rem;
      padding-inline: 0.8rem;
    }

    .hero-content {
      padding-inline: 1.15rem;
    }

    .hero-footer {
      align-items: flex-start;
      font-size: 0.6rem;
      padding-inline: 0.85rem;
    }

    .hero-footer a {
      margin-left: 1rem;
    }

    .panel-command {
      max-width: 8rem;
      overflow-wrap: anywhere;
    }

    .home-links .panel-heading {
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-actions a,
    .home-link {
      transition: none;
    }
  }
</style>
