---
import TerminalLayout from "../layouts/TerminalLayout.astro";
import { defaultWallpaperId, wallpapers } from "../data/wallpapers";
---

<TerminalLayout title="Appearance | Dellie">
  <main class="appearance-page">
    <header class="appearance-heading">
      <div>
        <p class="appearance-prompt">d3llie@website <span>~/appearance</span></p>
        <h1>Set the atmosphere.</h1>
        <p class="appearance-intro">
          Choose a background. Its colors gently shape the accents; the dark overlay and text colors stay fixed for readability.
        </p>
      </div>
      <a class="appearance-back" href="/">← Back to site</a>
    </header>

    <section class="appearance-surface" aria-labelledby="wallpaper-heading">
      <div class="surface-heading">
        <div>
          <p class="surface-kicker">01 / BACKGROUND</p>
          <h2 id="wallpaper-heading">Wallpaper</h2>
        </div>
        <p class="local-note">Preference saved in this browser</p>
      </div>

      <div class="wallpaper-grid">
        <button class="wallpaper-choice" type="button" data-wallpaper-choice="site-default" aria-pressed="false">
          <span class="wallpaper-preview default-preview" aria-hidden="true">
            <span class="preview-prompt">$ pywal --image</span>
            <span class="preview-glow"></span>
          </span>
          <span class="choice-copy">
            <strong>Site default</strong>
            <small>
              {defaultWallpaperId
                ? wallpapers.find((wallpaper) => wallpaper.id === defaultWallpaperId)?.name ?? "Configured default"
                : "Use the default from the site configuration"}
            </small>
          </span>
        </button>

        <button class="wallpaper-choice" type="button" data-wallpaper-choice="no-image" aria-pressed="false">
          <span class="wallpaper-preview plain-preview" aria-hidden="true">
            <span>dark / minimal</span>
          </span>
          <span class="choice-copy">
            <strong>No image</strong>
            <small>Keep the plain dark background</small>
          </span>
        </button>

        {wallpapers.map((wallpaper) => (
          <button
            class="wallpaper-choice"
            type="button"
            data-wallpaper-choice={wallpaper.id}
            aria-pressed="false"
          >
            <span class="wallpaper-preview">
              <img src={wallpaper.src} alt="" loading="lazy" />
              <span class="preview-image-overlay" aria-hidden="true"></span>
            </span>
            <span class="choice-copy">
              <strong>{wallpaper.name}</strong>
              <small>{wallpaper.id === defaultWallpaperId ? "Site default" : "Image palette"}</small>
            </span>
          </button>
        ))}
      </div>

      {wallpapers.length === 0 && (
        <p class="empty-gallery">
          No wallpapers are configured yet. Add your image URLs to
          <code>src/data/wallpapers.ts</code>; the gallery will appear here.
        </p>
      )}
    </section>

    <aside class="appearance-footnote">
      <span class="footnote-mark" aria-hidden="true">i</span>
      <p>
        Your selection only affects this browser. Colors are sampled when the image host allows it; otherwise the image uses its configured palette.
        The actual image stays softly blurred beneath a dark scrim.
      </p>
    </aside>

    <aside class="appearance-credit" aria-label="Credits">
      This atmospheric, image-driven terminal appearance was inspired by
      <a href="https://github.com/dylanaraps/pywal" target="_blank" rel="noopener noreferrer">pywal</a>
      by Dylan Araps.
    </aside>
  </main>
</TerminalLayout>

<style>
  .appearance-page {
    color: #e7eee9;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    margin: 0 auto;
    max-width: 860px;
    padding: clamp(1.25rem, 4vw, 3rem) 0;
    width: 100%;
  }

  .appearance-heading {
    align-items: end;
    border-bottom: 1px solid rgba(221, 238, 226, 0.14);
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    padding-bottom: 1.5rem;
  }

  .appearance-prompt,
  .surface-kicker {
    color: var(--site-accent);
    font-family: var(--font-terminal);
    font-size: 0.75rem;
    margin: 0 0 0.65rem;
  }

  .appearance-prompt span {
    color: #a4b4aa;
  }

  .appearance-heading h1 {
    font-size: clamp(2rem, 6vw, 3.2rem);
    letter-spacing: -0.055em;
    line-height: 1.05;
    margin: 0;
  }

  .appearance-intro {
    color: #b6c3ba;
    line-height: 1.65;
    margin: 0.8rem 0 0;
    max-width: 42rem;
  }

  .appearance-back {
    border: 1px solid rgba(221, 238, 226, 0.2);
    border-radius: 999px;
    color: #e7eee9;
    flex: 0 0 auto;
    font-size: 0.85rem;
    padding: 0.65rem 0.9rem;
  }

  .appearance-back:hover {
    background: rgba(15, 22, 18, 0.85);
    text-decoration: none;
  }

  .appearance-surface {
    backdrop-filter: blur(14px);
    background: rgba(13, 19, 16, 0.78);
    border: 1px solid rgba(221, 238, 226, 0.15);
    border-radius: 1rem;
    margin-top: 1.5rem;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .surface-heading {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .surface-kicker {
    font-size: 0.65rem;
    margin-bottom: 0.25rem;
  }

  .surface-heading h2 {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .local-note {
    color: #a4b4aa;
    font-size: 0.75rem;
    margin: 0;
  }

  .wallpaper-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .wallpaper-choice {
    align-items: center;
    background: rgba(22, 31, 26, 0.9);
    border: 1px solid rgba(221, 238, 226, 0.14);
    border-radius: 0.8rem;
    color: inherit;
    cursor: pointer;
    display: flex;
    gap: 0.85rem;
    min-width: 0;
    padding: 0.65rem;
    text-align: left;
    transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease;
  }

  .wallpaper-choice:hover {
    background: rgba(30, 43, 35, 0.96);
    transform: translateY(-1px);
  }

  .wallpaper-choice[aria-pressed="true"] {
    background: color-mix(in srgb, var(--site-accent) 9%, rgba(22, 31, 26, 0.94));
    border-color: var(--site-accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--site-accent) 32%, transparent);
  }

  .wallpaper-preview {
    align-items: center;
    background: #101714;
    border: 1px solid rgba(221, 238, 226, 0.12);
    border-radius: 0.55rem;
    display: flex;
    flex: 0 0 5.25rem;
    height: 3.5rem;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .wallpaper-preview img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .default-preview {
    background:
      radial-gradient(ellipse at 30% 25%, rgba(123, 164, 127, 0.6), transparent 55%),
      linear-gradient(140deg, #1d3129, #18212a);
  }

  .preview-prompt {
    color: #edf4ee;
    font: 0.55rem var(--font-terminal);
    position: relative;
    z-index: 1;
  }

  .preview-glow {
    background: var(--site-glow);
    border-radius: 50%;
    filter: blur(10px);
    height: 2rem;
    position: absolute;
    right: 0;
    top: 0;
    width: 2rem;
  }

  .plain-preview {
    background: linear-gradient(145deg, #0d1310, #18211c);
    color: #91a197;
    font: 0.56rem var(--font-terminal);
  }

  .preview-image-overlay {
    background: linear-gradient(0deg, rgba(7, 11, 9, 0.62), transparent);
    inset: 0;
    position: absolute;
  }

  .choice-copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .choice-copy strong {
    font-size: 0.88rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .choice-copy small {
    color: #a4b4aa;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .empty-gallery {
    background: rgba(7, 11, 9, 0.45);
    border: 1px dashed rgba(221, 238, 226, 0.18);
    border-radius: 0.65rem;
    color: #b6c3ba;
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
  }

  .empty-gallery code {
    color: var(--site-accent);
    font-family: var(--font-terminal);
    font-size: 0.8em;
    overflow-wrap: anywhere;
  }

  .appearance-footnote {
    align-items: flex-start;
    color: #aebcb3;
    display: flex;
    font-size: 0.82rem;
    gap: 0.7rem;
    line-height: 1.6;
    margin: 1rem 0 0;
  }

  .appearance-footnote p {
    margin: 0;
  }

  .appearance-credit {
    color: #a4b4aa;
    font-size: 0.75rem;
    margin-top: 1.25rem;
    text-align: center;
  }

  .appearance-credit a {
    color: var(--site-accent);
    text-underline-offset: 0.15em;
  }

  .footnote-mark {
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--site-accent) 58%, transparent);
    border-radius: 50%;
    color: var(--site-accent);
    display: inline-flex;
    flex: 0 0 1.2rem;
    font-family: var(--font-terminal);
    font-size: 0.75rem;
    height: 1.2rem;
    justify-content: center;
    margin-top: 0.1rem;
    width: 1.2rem;
  }

  @media (max-width: 600px) {
    .appearance-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .wallpaper-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .surface-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wallpaper-choice {
      transition: none;
    }
  }
</style>
