---
export const prerender = false;
const session = Astro.locals.session ?? null;
const user = Astro.locals.user ?? null;
import { D3_EMAIL } from "astro:env/server";
import { isAdminEmail } from "../../lib/access-control";

if (!session || !user) return Astro.redirect("/login");
if (!isAdminEmail(user.email, D3_EMAIL)) {
  return new Response("Forbidden", { status: 403 });
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin dashboard</title>
  </head>
  <body>
    <main>
      <h1>Welcome back, Dellie.</h1>
      <p>Signed in as {user.email}</p>
      <p>This private dashboard is ready for future tools.</p>
      <a href="/">Back to site</a>
      <a href="/login">Account</a>
    </main>
  </body>
</html>
