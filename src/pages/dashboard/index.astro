---
export const prerender = false;
import TerminalLayout from "../../layouts/TerminalLayout.astro";
import { env } from "cloudflare:workers";
import { defaultWallpaperId, wallpapers } from "../../data/wallpapers";
import { getDefaultWallpaperId } from "../../lib/site-settings";
import { fetchServiceInventory, type ServiceInventory } from "../../lib/service-inventory";

if (!Astro.locals.isAdmin) return Astro.redirect("/login");
Astro.response.headers.set("Cache-Control", "no-store");

let activeWallpaperId = defaultWallpaperId;
let settingsLoadError = false;
try {
  activeWallpaperId = await getDefaultWallpaperId(env);
} catch (error) {
  console.error("Failed to load the admin appearance setting.", error);
  settingsLoadError = true;
}

const updated = Astro.url.searchParams.get("updated") === "1";
const errorCode = Astro.url.searchParams.get("error");
let inventory: ServiceInventory | undefined;
try {
  inventory = await fetchServiceInventory(env.GITHUB_CONTENT_TOKEN ?? "");
} catch (error) {
  console.error("Failed to load the private service inventory.", error);
}
const serviceGroups = inventory?.groups ?? [];
---

<TerminalLayout title="Admin dashboard | Dellie">
  <main class="admin-dashboard">
    <header>
      <div>
        <p class="admin-prompt">d3llie@website ~ $ admin --settings</p>
        <h1>Site settings</h1>
        <p>Signed in as <strong>delster1</strong>.</p>
      </div>
      <form action="/api/admin/logout" method="post">
        <button class="btn" type="submit" variant-="yellow">Sign out</button>
      </form>
    </header>

    <section box-="round" style="--box-bg: var(--bg1)" aria-labelledby="background-title">
      <h2 id="background-title">Default background</h2>
      <p>
        Choose the background used by visitors who select “Site default.” Their own saved
        appearance choices are not changed.
      </p>

      {settingsLoadError && (
        <p class="admin-error" role="alert">
          Could not load the saved setting. Check the database migration and connection before saving.
        </p>
      )}
      {updated && <p class="admin-success" role="status">Default background updated.</p>}
      {errorCode === "invalid" && (
        <p class="admin-error" role="alert">Choose one of the available background options.</p>
      )}
      {errorCode === "save-failed" && (
        <p class="admin-error" role="alert">Could not save the setting. Check the database connection.</p>
      )}

      <form action="/api/appearance/default" method="post" class="admin-setting-form">
        <label for="wallpaperId">Site-wide default</label>
        <select id="wallpaperId" name="wallpaperId" disabled={settingsLoadError}>
          <option value="no-image" selected={activeWallpaperId === "no-image"}>No image</option>
          {wallpapers.map((wallpaper) => (
            <option value={wallpaper.id} selected={activeWallpaperId === wallpaper.id}>
              {wallpaper.name}
            </option>
          ))}
        </select>
        <button class="btn" type="submit" variant-="yellow" disabled={settingsLoadError}>
          Save default
        </button>
      </form>
    </section>

    <section class="service-section" box-="round" style="--box-bg: var(--bg1)" aria-labelledby="services-title">
      <header>
        <h2 id="services-title">Service shortcuts</h2>
        <p>Links and documented container states from the private Obsidian service inventory.</p>
      </header>
      {!inventory && (
        <p class="admin-error" role="alert">
          Could not load the service inventory. Check the notes repository and GITHUB_CONTENT_TOKEN access.
        </p>
      )}
      {inventory && (
        <p>
          Last verified: {inventory.verified}. This is a documented snapshot, not live monitoring.
          Notes refresh within five minutes.
        </p>
      )}
      <div class="service-groups">
        {serviceGroups.map((group) => (
          <section aria-label={group.title}>
            <h3>{group.title}</h3>
            <ul>
              {group.services.map((service) => (
                <li>
                  <a href={service.url} target="_blank" rel="noopener noreferrer">
                    <span>{service.name}</span>
                    <small>{new URL(service.url).hostname}</small>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      {inventory && (
        <div class="service-inventory" tabindex="0" role="region" aria-label="Documented running containers">
          <table>
            <caption>Documented running containers ({inventory.services.length})</caption>
            <thead>
              <tr><th scope="col">Container</th><th scope="col">Role</th><th scope="col">Recorded state</th></tr>
            </thead>
            <tbody>
              {inventory.services.map((service) => (
                <tr>
                  <th scope="row">{service.name}<small>{service.group}</small></th>
                  <td>{service.role}</td>
                  <td class:list={{ "admin-error": /unhealthy/i.test(service.state) }}>{service.state}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <nav class="service-tools" aria-label="Website management tools">
        <a href="https://github.com/delster1/obsidianNotes/blob/main/global/homelab/SERVICES.md" target="_blank" rel="noopener noreferrer">
          Service inventory in private notes
        </a>
        <a href="https://github.com/delster1/delster1.github.io" target="_blank" rel="noopener noreferrer">
          Website source on GitHub
        </a>
        <a href="https://dash.cloudflare.com" target="_blank" rel="noopener noreferrer">
          Cloudflare dashboard
        </a>
      </nav>
    </section>

    <nav class="admin-links" aria-label="Admin navigation">
      <a href="/appearance">Preview backgrounds</a>
      <a href="/">Back to site</a>
    </nav>
  </main>
</TerminalLayout>

<style>
  .admin-dashboard {
    display: grid;
    gap: 1.25rem;
    margin: 0 auto;
    max-width: 48rem;
    padding: clamp(1.25rem, 4vw, 3rem) 0;
  }

  .admin-dashboard header,
  .admin-setting-form,
  .admin-links {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    justify-content: space-between;
  }

  .admin-dashboard h1 {
    margin: 0.3rem 0;
  }

  .admin-dashboard h2 {
    margin-top: 0;
  }

  .service-section > header p {
    margin-bottom: 0;
  }

  .service-groups {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin-top: 1rem;
  }

  .service-groups h3 {
    font-size: 1rem;
    margin: 0 0 0.6rem;
  }

  .service-groups ul {
    display: grid;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-groups a {
    align-items: baseline;
    border: 1px solid var(--bg3);
    border-radius: 0.35rem;
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    justify-content: space-between;
    padding: 0.55rem 0.7rem;
    text-decoration: none;
  }

  .service-groups a:hover,
  .service-tools a:hover {
    border-color: var(--site-accent);
    color: var(--site-accent);
  }

  .service-groups small {
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .service-tools {
    border-top: 1px solid var(--bg3);
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
  }

  .service-inventory {
    margin-top: 1.5rem;
    overflow-x: auto;
  }

  .service-inventory table {
    border-collapse: collapse;
    width: 100%;
  }

  .service-inventory th,
  .service-inventory td {
    border-bottom: 1px solid var(--bg3);
    padding: 0.6rem;
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .service-inventory small {
    display: block;
    font-weight: normal;
  }

  .admin-prompt {
    color: var(--site-accent);
    font-family: var(--font-terminal);
    font-size: 0.8rem;
    margin: 0;
  }

  .admin-setting-form {
    justify-content: start;
    margin-top: 1.25rem;
  }

  .admin-setting-form label {
    flex-basis: 100%;
  }

  .admin-setting-form select {
    background: var(--bg0);
    border: 1px solid var(--bg3);
    border-radius: 0.35rem;
    color: var(--text);
    flex: 1 1 15rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
  }

  .admin-error {
    color: #ff9a9a;
  }

  .admin-success {
    color: var(--site-accent);
  }

  .admin-links {
    justify-content: start;
  }
</style>
