		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "79b5426459b74b8ea883f56448f7a90d",
		},
		{
			"binding": "SITE_SETTINGS_DB",
			"id": "997c4e3816ff4b4db6308638976e932e"
		},
	],
	"ratelimits": [
		{
			"name": "ADMIN_LOGIN_LIMITER",
			"namespace_id": "982716453",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
}