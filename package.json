{
  "name": "delster1.github.io",
  "version": "1.0.0",
  "type": "module",
  "description": "Personal site built with Astro + TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm audit --omit=dev --audit-level=high && npm run check && npm test",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "tsx --test src/lib/*.test.ts",
    "db:dev:start": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:dev:stop": "docker compose -f docker-compose.dev.yml stop postgres",
    "db:dev:generate": "drizzle-kit generate",
    "db:dev:migrate": "drizzle-kit migrate",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delster1/delster1.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/delster1/delster1.github.io/issues"
  },
  "homepage": "https://delster1.github.io",
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@tailwindcss/vite": "^4.3.4",
    "@webtui/css": "^0.1.5",
    "@webtui/plugin-nf": "^0.1.1",
    "@webtui/theme-everforest": "^0.0.3",
    "@webtui/theme-nord": "^0.0.2",
    "astro": "^7.4.5",
    "better-auth": "^1.7.16",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.4",
    "figlet": "^1.12.0",
    "marked": "^17.0.1",
    "pg": "^8.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.9",
    "prettier": "^3.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}
